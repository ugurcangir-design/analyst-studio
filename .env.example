# ═══════════════════════════════════════════════════════════════════
#  Analyst Studio — Yapılandırma
#  Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── AI Erişimi (BİRİNİ seçin) ──────────────────────────────────────

# Seçenek A (ÖNERİLEN): Claude CLI — abonelik kapsamında, ücretsiz.
# Önce kurun:  npm install -g @anthropic-ai/claude-code  →  sonra: claude (giriş)
USE_CLAUDE_CLI=true
# CLI modunda kullanılacak model. Boş bırakılırsa Claude Code KENDİ varsayılanını
# seçer (bu bir premium/pahalı model — ör. 'fable' — olabilir → istenmeyen ücretli
# kullanım). Bu yüzden açıkça belirtilir. Alias: sonnet | opus | haiku (ya da tam ad).
CLAUDE_CLI_MODEL=sonnet

# Seçenek B: Doğrudan Anthropic API — token bazlı ücret.
# Yukarıdaki satırı silin/false yapın ve aşağıyı doldurun:
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Token / Hız Ayarları (opsiyonel) ───────────────────────────────
# HIZLI_MOD=true          # Teknik analizin AI denetçi aşamasını atlar.
#                         # Denetçi, teknik+süreç metnini İKİNCİ kez modele
#                         # gönderen en pahalı ikinci çağrıdır — 429 limitine
#                         # takılıyorsanız açın. Deterministik kapsam denetimi
#                         # (ID izlenebilirlik) her durumda çalışır.
# EXTENDED_THINKING=true  # Daha derin akıl yürütme (daha yavaş + daha çok token)
# API_CACHE=false         # Çıktı önbelleğini kapat (varsayılan açık — aynı
#                         # girdiyle tekrar çalıştırma 0 token harcar)

# ── Çalışma Modu (lokal kullanım için dokunmayın) ──────────────────
# HOST=127.0.0.1          # varsayılan: sadece yerel erişim
# AUTH_ENABLED=false      # lokal kullanımda kapalı kalır
# SECRET_KEY=...          # boş bırakın — uygulama otomatik üretir

# ── Kullanım Telemetrisi ───────────────────────────────────────────
# Analist adı normalde UI'dan girilir (Ayarlar → "Analist Adı Soyadı" → analist.json).
# Sink URL koda gömülü (skills/telemetri.py → VARSAYILAN_SINK_URL). Aşağıdakiler opsiyonel override:
# ANALYST_NAME=ugur       # analist.json yoksa atıf için (login > analist.json > bu > OS user).
# USAGE_SINK_URL=...      # Gömülü toplayıcı URL'yi override eder (Google Apps Script Web App).
# --- Owner konsolu ("Kullanım Raporu" + "Yetki" ekranları) ---
# ARTIK .env'de DEĞİL — kilit gitignore'lu YEREL DOSYADADIR: reference/owner_konsol.json
# ({"owner_konsol": true}). Sebep: .env bir analiste kopyalanırsa eski OWNER_KONSOL/YETKI_PANELI
# bayrakları bu ekranları açıyordu. Dosya git'e gitmez, .env paylaşımıyla taşınmaz, .example'dan
# false seed edilir → owner HARİCİNDEKİ tüm agent'larda KAPALI. Owner kendi makinesinde:
#   reference/owner_konsol.json içinde  "owner_konsol": true  yapar (tek seferlik).
# (Eski OWNER_KONSOL / YETKI_PANELI / USAGE_DASHBOARD env bayrakları ARTIK OKUNMAZ.)
# USAGE_SINK_KEY=...      # Uzaktan Çek için Apps Script okuma anahtarı (owner).

# ── Uygulama portu (varsayılan 5003) ──
PORT=5003

# ── Otomatik güncelleme (v2 Faz 2.5) ──
# Açık (varsayılan): iş yokken origin/main'den otomatik çeker + yeniden başlar.
# Kapatmak için: AUTO_UPDATE=false
# AUTO_UPDATE=true
# AUTO_UPDATE_INTERVAL=600   # saniye (kontrol aralığı)

# ── Zamanlanmış disk temizliği (v2 Faz 3) ──
# Açık (varsayılan): iş yokken eskimiş önbellek (.api_cache), döndürülmüş log, UAT raporu (.xlsx),
# canlı-uygulama gözlem dosyası ve eski oturum arşivini siler. Analiz çıktıları/girdiler ASLA silinmez.
# DISK_TEMIZLIK=true
# DISK_TEMIZLIK_ARALIK=86400   # saniye (varsayılan 24 saat; en az 3600)

# ── Jira Köprüsü — Jira'yı web-chat gibi kullan (polling + taslak/onay) ──
# Task YORUMUNA '/analyst_agent analiz' yazılır → app JQL taramasıyla bulur, analiz eder,
# sonucu Jira YORUMU olarak yazar. Inbound bağlantı/webhook/tünel GEREKMEZ (lokal + OAuth).
# Varsayılan KAPALI; yalnız owner açar. Yazma (task güncelle / yeni task) → taslak+onay (MVP-2).
# JIRA_KOPRU=true
# JIRA_KOPRU_PROJELER=PROJE1,PROJE2     # taranan Jira proje anahtarlarınız (zorunlu; boşsa çalışmaz) — ŞİRKET BİLGİSİ .env'de, git'e gitmez
# JIRA_KOPRU_ARALIK=60                  # saniye (tarama aralığı; en az 20)
# JIRA_KOPRU_PENCERE_DK=120             # kaç dakikalık güncellemeye bakılır
# JIRA_KOPRU_KOMUT=/analyst_agent       # tetik komut prefiksi
# JIRA_KOPRU_YAZAR_ALLOWLIST=           # ZORUNLU (güvenlik): yetkili Jira accountId'leri, virgüllü.
#                                       # BOŞ = fail-closed (yorum komutları İŞLENMEZ). displayName kabul EDİLMEZ.

# ── Sahiplik (owner) — yalnız çok-kullanıcılı AUTH açık kurulumda gerekir ──
# ADMIN_USER=<owner_kullanici_adi>   # bu kişi 'owner', diğerleri 'analist'
# AUTH_ENABLED=true                  # login zorunlu kıl (paylaşımlı sunucu)

# ── Analiz modeli (CLI modu; API key GEREKMEZ, abonelik kapsamında) ──
# Arayüzden de seçilir (Ana Sayfa → AI/Kota). Fable gibi kredi-gerektiren modeller HARİÇ.
# Örnekler: claude-sonnet-5 (dengeli) · claude-opus-4-8 / claude-opus-5 (güçlü) · claude-haiku-4-5-20251001 (hızlı)
# CLAUDE_CLI_MODEL=claude-opus-5-5   # ana katman önerisi (CLI 2.1.303+); 4.8'e göre daha ucuz, daha az tur

# ── RAG getirim bütçesi (token/maliyet) ──
# Tüm referansların TOPLAM karakter tavanı (0/negatif = sınırsız).
# MAX_CHARS_REF_GLOBAL=140000
# CLI modunda prompt-cache YOK → bütçe her çağrıda tam ödenir; CLI için daha sıkı tavan (≈25K token):
# MAX_CHARS_REF_GLOBAL_CLI=100000

# Canlı uygulama (Chrome MCP) gözlemi — model hiç tarayıcı aracı çağırmazsa (num_turns=1) sertleştirilmiş
# talimatla BİR KEZ daha dener (varsayılan true). Maliyet kontrolü için false yapılabilir.
# LIVE_APP_TEKRAR=true
# Canlı gözlemli CLI çağrısının zaman aşımı (sn; varsayılan 720).
# LIVE_APP_CLI_TIMEOUT=720

# Task Analizi açık sorularını analist görmeden agent araştırır (referans/kod/tüketici taraması + gerekirse 1 canlı gözlem);
# cevaplananlar ekranda önceden dolu gelir. false → kapalı (HIZLI_MOD da kapatır).
# SORU_COZUMLEME=true
# Kanıtla cevaplanan sorular analize otomatik işlensin (auto, tek ucuz düzeltme çağrısı) mı, analist onaylasın (onay) mı?
# SORU_COZUMLEME_UYGULA=auto

# Analiz öncesi canlı uygulama giriş doğrulamasının geçerlilik süresi (sn). Bu süre içinde aynı URL+hesapla
# başarılı giriş varsa yeniden denenmez; URL/şifre değişince otomatik geçersizleşir.
# GIRIS_TEST_GECERLILIK=3600

# Paralel canlı gözlem profil havuzu: aynı anda kaç gözlem (Task/İnteraktif/Kabul/Süreç) çalışabilir (vars. 6, en çok 16).
# Havuz doluysa yeni çağrı LIVE_APP_SLOT_BEKLE sn (vars. 300) bekler, sonra net hata verir.
# LIVE_APP_PARALEL=6
# LIVE_APP_SLOT_BEKLE=300

# Kota — canlı gözlem fazı (docs/KOTA-OPTIMIZASYON-PLANI.md): gözlem döngüsü tur tavanı (vars. 40; tavana takılınca
# rapor mevcut kanıtla tamamlatılır) ve cevap turu/düzeltmede taze gözlem raporunun yeniden kullanım süresi (sn, vars. 6 saat;
# yeni "Teknik Analiz Et" her zaman taze gözler).
# LIVE_APP_MAX_TUR=40
# Tavana takılınca bütçe kaç kez yenilenip AYNI oturum sürdürülür (genel; kabul kontrolü kendi KABUL_TUR_DEVAM'ını kullanır)
# LIVE_APP_TUR_DEVAM=0
# Kabul Kontrolü tur bütçesi: taban + madde×katsayı (tavanla sınırlı) · devam hakkı · denenemeyen maddeler için tamamlama turu (0 kapatır)
# KABUL_TUR_TABAN=40
# KABUL_TUR_MADDE=6
# KABUL_TUR_TAVAN=160
# KABUL_TUR_DEVAM=2
# KABUL_TAMAMLAMA=1
# BFF keşfi tur bütçesi (CRUD döngüsü; 1 devam hakkı otomatik)
# BFF_MAX_TUR=70
# Canlı çağrıda Claude CLI yerleşik araçları (Bash/Read…) ilk denemede KAPALI (tur başına ~27k token tasarruf; tekrar denemesi açar).
# true → hep açık (eski davranış; soğuk başlangıçta araçsız ilk tur sorunu yaşayan makine için)
# LIVE_APP_YERLESIK_ARACLAR=false
# GOZLEM_RAPOR_GECERLILIK=21600
# Kota Faz 2 — 'Cevapları İşle' hedefli (mevcut analize uygula; baştan üretmez). false → eski tam yeniden üretim.
# CEVAP_HEDEFLI=true
# Kota Faz 3 — model katmanları (yalnız CLI modu). 'ana' = CLAUDE_CLI_MODEL (analiz/denetçi/FE-BE bölme).
# 'yardimci' = gözlem fazı, giriş testi, BFF keşfi, kabul kontrolü, soru çözümleme, hedefli düzeltme/cevap, ekran envanteri.
# 'hafif' = formatla, test senaryoları, açık soru toplama. Alias'lar CLI 2.1.303+'ta sonnet→Sonnet 5.5, haiku→Haiku 5.5.
# CLI_MODEL_YARDIMCI=sonnet
# CLI_MODEL_HAFIF=haiku

# ── Kodda okunan ancak yukarıda geçmeyen ayarlar (2026-10-20 denetimi; hepsi opsiyonel, varsayılanla çalışır) ──
# AKIS_KAPATMA=true              # Süreç/teknik analiz sonrası otomatik 'Akış Kapatma' (boşluk tespiti); false → kapalı
# ALLOW_LAN_NO_AUTH=false        # HOST=0.0.0.0 + AUTH_ENABLED=false birleşimine bilerek izin ver (riskli; varsayılan reddeder)
# API_CACHE_TTL=604800           # AI çıktı önbelleği ömrü (sn; varsayılan 7 gün)
# AUTO_REF_SYNC=true             # Günlük otomatik Confluence/Jira/Swagger referans senkronu; false → kapalı
# BILDIRIM=true                  # macOS yerel masaüstü bildirimi (analiz bitti/hata/köprü komutu); false → kapalı
# CHROME_PATH=                   # Mockup PNG render için tarayıcı yolu (boş → kurulu Chrome/Chromium/Edge/Brave otomatik bulunur)
# CLI_LIMIT_API_FALLBACK=true    # CLI 429 limitinde ANTHROPIC_API_KEY varsa o çağrıyı API ile tamamla; false → net hata
# CLI_YALIN=true                 # `claude -p` sabit bağlam diyeti (araç şemaları/slash kapalı; ~98k→62k); false → eski davranış
# DESKTOP_IDLE_KAPAT_SAAT=0      # Heartbeat gelmeyen idle sunucuyu N saat sonra kapat (0 = asla; yalnız iş yokken)
# DESKTOP_MODE=false             # Masaüstü başlatıcı modu (watchdog: sekme kapanınca `/api/bye` → sunucu kapanır); start.sh true geçer
# GOREV_PARALEL=3                # Task Analizi'nde aynı anda işlenen görev adedi (ThreadPoolExecutor)
# KOTA_OLCUM_BASLANGIC=2026-10-19T18:00:00   # Kullanım Raporu 'güncelleme öncesi/sonrası' kota kıyas kesim anı (ISO)
# SESSION_COOKIE_SECURE=false    # Oturum çerezi yalnız HTTPS'te gönderilsin (paylaşımlı sunucu + TLS'te true yapın)
# SIRKET_EPOSTA_DOMAIN=sans-technology.com   # Analist kimliğinde zorunlu e-posta domaini (Ayarlar → e-posta doğrulaması)
# TELEMETRI_SINK=                # off|0|false → test/geliştirme makinesi: ekip Sheet'ine HİÇ gönderme + olaylar geçici dizine
# USAGE_SINK_TOKEN=              # Opsiyonel paylaşılan sink sırrı; doluysa POST gövdesine/GET'e `t` olarak eklenir
#                                # (docs/telemetri-apps-script.md 'Güvenlik sertleştirme'; boş → eski davranış)

# ── Denetim 2026-10-20 (dayanıklılık) ────────────────────────────────────────
# Tek canlı gözlem çağrısının TOPLAM süre tavanı (ilk koşu + devam + tamamlatma + tekrar), sn
# LIVE_APP_TOPLAM_SURE=1500
# "Tam yeniden üret" (/api/rerun) alt süreç zaman aşımı, sn (process grubuyla öldürülür)
# RERUN_TIMEOUT=1800
# 'calisiyor' kalmış bellek-içi iş kaydı kaç sn sonra restart/güncellemeyi bloklamaz sayılır
# ARKA_PLAN_IS_AZAMI_SN=7200
# Açık soru çözüm gözlemi tur bütçesi: taban + soru×katsayı (tavanla sınırlı); 1 devam hakkı otomatik
# SORU_GOZLEM_TUR_TABAN=25
# SORU_GOZLEM_TUR_MADDE=20
# SORU_GOZLEM_TUR_TAVAN=110
